{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "SeetaPsych WebUI (Streamlit)",
      "type": "debugpy",
      "request": "launch",
      "module": "streamlit",
      "args": [
        "run",
        "seetapsych_lib/webui/app.py",
        "--",
        "--log",
        "INFO"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true,
      "subProcess": true,
      "env": {
        "PYTHONUNBUFFERED": "1"
      }
    }
  ]
}
