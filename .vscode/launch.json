{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Fabopsy WebUI (Streamlit)",
      "type": "debugpy",
      "request": "launch",
      "module": "streamlit",
      "args": [
        "run",
        "fabopsy_lib/webui/app.py",
        "--",
        "--disable-builtin",
        "--dirs",
        "${workspaceFolder}/fabopsy_lib/example",
        "--log",
        "INFO"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true,
      "subProcess": true,
      "env": {
        "PYTHONUNBUFFERED": "1"
      }
    },
    {
      "name": "Fabopsy WebUI (Streamlit, custom cache/upload)",
      "type": "debugpy",
      "request": "launch",
      "module": "streamlit",
      "args": [
        "run",
        "fabopsy_lib/webui/app.py",
        "--",
        "--disable-builtin",
        "--dirs",
        "${workspaceFolder}/fabopsy_lib/example",
        "--log",
        "DEBUG",
        "--cache-dir",
        "${workspaceFolder}/.cache",
        "--upload-dir",
        "${workspaceFolder}/.upload"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true,
      "subProcess": true,
      "env": {
        "PYTHONUNBUFFERED": "1"
      }
    }
  ]
}
